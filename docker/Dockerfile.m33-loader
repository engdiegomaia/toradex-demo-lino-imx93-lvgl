# Resident container that loads the FreeRTOS rt_latency firmware into the
# Cortex-M33 of the i.MX93 via /sys/class/remoteproc/remoteproc0.
#
# This is the Torizon HMP pattern: the OSTree rootfs is read-only, so we ship
# the firmware inside a dedicated container that writes to sysfs. It remains
# alive so Docker restarts it automatically after every host reboot.
#
# See:
#   https://developer.toradex.com/software/hmp/hmp-nxp/how-to-load-firmwares-nxp/

FROM --platform=linux/arm64 debian:bookworm-slim

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        coreutils \
        util-linux \
        mount \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /firmware
COPY app/custom/elf/rt_latency_cm33.elf /firmware/rt_latency_cm33.elf
COPY docker/m33-loader.sh /usr/local/bin/m33-loader.sh
RUN chmod +x /usr/local/bin/m33-loader.sh

ENTRYPOINT ["/usr/local/bin/m33-loader.sh"]
