          "code": "lv_obj_add_flag(ui->Home.container_radio_cb_core_A1, LV_OBJ_FLAG_EVENT_BUBBLE);\r\nlv_obj_add_flag(ui->Home.container_radio_cb_core_m33, LV_OBJ_FLAG_EVENT_BUBBLE);\r\nlv_obj_add_event_cb(ui->Home.container_1_container_radio, radio_event_handler, LV_EVENT_CLICKED, &cortexID);\r\nlv_obj_add_state(lv_obj_get_child(ui->Home.container_1_container_radio, 0), LV_STATE_CHECKED);"
